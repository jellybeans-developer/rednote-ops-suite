# Local data directory. Keep it outside synced/public folders in production.
REDNOTE_DATA_DIR=.rednote-ops

# Optional bearer token required by HTTP transport. Required when binding non-loopback.
REDNOTE_MCP_TOKEN=replace-with-at-least-32-random-characters

# HTTP mode settings. Loopback is the secure default.
REDNOTE_HOST=127.0.0.1
REDNOTE_PORT=3210

# Mutating tools can be disabled for read-only deployments.
REDNOTE_READ_ONLY=false
