# Local data directory. Keep it outside synced/public folders in production.
REDNOTE_DATA_DIR=.rednote-ops

# Optional bearer token required by HTTP transport. Required when binding non-loopback.
REDNOTE_MCP_TOKEN=replace-with-at-least-32-random-characters

# HTTP mode settings. Loopback is the secure default.
REDNOTE_HOST=127.0.0.1
REDNOTE_PORT=3210

# Mutating tools can be disabled for read-only deployments.
REDNOTE_READ_ONLY=false

# Official Xiaohongshu openaccount OAuth scaffold. Disabled by default.
# Registering an official app is your responsibility. OAuth is not publish permission.
# Leave these commented unless you explicitly need device grant + min_user_info.
# REDNOTE_OPENACCOUNT_OAUTH_ENABLED=false
# REDNOTE_OPENACCOUNT_APP_ID=
# REDNOTE_OPENACCOUNT_APP_SECRET=
# REDNOTE_OPENACCOUNT_BASE_URL=https://openaccount.xiaohongshu.com
# REDNOTE_OPENACCOUNT_CLIENT_NAME=RedNote Ops Suite

# Experimental browser-assisted Creator Center adapter. Disabled by default.
# A visible local Chrome/Edge window is opened and you complete login yourself.
# The browser profile keeps its session in REDNOTE_DATA_DIR; MCP never returns cookies.
# REDNOTE_CREATOR_BROWSER_ENABLED=false
# REDNOTE_CREATOR_BROWSER_CHANNEL=chrome
# REDNOTE_CREATOR_PROFILE_DIR=
# Final publish clicking has a separate opt-in and should stay false during setup.
# REDNOTE_CREATOR_ALLOW_PUBLISH=false
